package com.tjanabot.chatbot.integration.controller;

import com.fasterxml.jackson.databind.ObjectMapper;
import com.tjanabot.chatbot.model.AuditLog;
import com.tjanabot.chatbot.model.User;
import com.tjanabot.chatbot.repository.AuditLogRepository;
import com.tjanabot.chatbot.repository.UserRepository;
import com.tjanabot.chatbot.security.JwtTokenProvider;
import com.tjanabot.chatbot.service.AuditExportService;
import com.tjanabot.chatbot.service.AuditService;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.DisplayName;
import org.junit.jupiter.api.Test;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc;
import org.springframework.boot.test.context.SpringBootTest;
import org.springframework.http.MediaType;
import org.springframework.test.context.ActiveProfiles;
import org.springframework.test.context.bean.override.mockito.MockitoBean;
import org.springframework.test.web.servlet.MockMvc;

import java.time.LocalDateTime;
import java.util.Arrays;
import java.util.List;
import java.util.Optional;

import static org.hamcrest.Matchers.*;
import static org.mockito.ArgumentMatchers.any;
import static org.mockito.ArgumentMatchers.*;
import static org.mockito.Mockito.*;
import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.*;
import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.*;

/**
 * Integration tests for AuditLogController
 *
 * Tests covered:
 * - Audit log creation for user actions
 * - Audit log retrieval with filtering
 * - Audit log export functionality
 * - Security event logging
 * - Admin access to audit logs
 */
@SpringBootTest
@AutoConfigureMockMvc
@ActiveProfiles("test")
@DisplayName("AuditLogController Integration Tests")
class AuditLogControllerIT {

    @Autowired
    private MockMvc mockMvc;

    @Autowired
    private ObjectMapper objectMapper;

    @MockitoBean
    private AuditService auditService;

    @MockitoBean
    private AuditExportService auditExportService;

    @MockitoBean
    private AuditLogRepository auditLogRepository;

    @MockitoBean
    private UserRepository userRepository;

    @MockitoBean
    private JwtTokenProvider jwtTokenProvider;

    private User testUser;
    private User adminUser;
    private AuditLog testAuditLog;
    private String authToken;
    private String adminToken;

    @BeforeEach
    void setUp() {
        testUser = new User();
        testUser.setId(1L);
        testUser.setEmail("user@example.com");
        testUser.setUsername("testuser");

        adminUser = new User();
        adminUser.setId(2L);
        adminUser.setEmail("admin@example.com");
        adminUser.setUsername("admin");

        testAuditLog = new AuditLog();
        testAuditLog.setId(100L);
        testAuditLog.setUserId(1L);
        testAuditLog.setAction("USER_LOGIN");
        testAuditLog.setResourceType("Authentication");
        testAuditLog.setResourceId(1L);
        testAuditLog.setIpAddress("192.168.1.1");
        testAuditLog.setUserAgent("Mozilla/5.0");
        testAuditLog.setTimestamp(LocalDateTime.now());

        authToken = "Bearer test_token_123";
        adminToken = "Bearer admin_token_456";

        // Mock JWT token validation
        when(jwtTokenProvider.validateToken(anyString())).thenReturn(true);
        when(jwtTokenProvider.getUserIdFromToken("test_token_123")).thenReturn(1L);
        when(jwtTokenProvider.getUserIdFromToken("admin_token_456")).thenReturn(2L);
        when(userRepository.findById(1L)).thenReturn(Optional.of(testUser));
        when(userRepository.findById(2L)).thenReturn(Optional.of(adminUser));
    }

    @Test
    @DisplayName("Should create audit log for user login")
    void shouldCreateAuditLogForUserLogin() throws Exception {
        // Arrange
        doNothing().when(auditService).logUserLogin(eq(1L), anyString(), anyString());

        // Act & Assert
        mockMvc.perform(post("/api/audit/log/login")
                .header("Authorization", authToken)
                .contentType(MediaType.APPLICATION_JSON)
                .content("{\"ipAddress\": \"192.168.1.1\", \"userAgent\": \"Mozilla/5.0\"}"))
            .andExpect(status().isOk());

        verify(auditService, times(1)).logUserLogin(eq(1L), anyString(), anyString());
    }

    @Test
    @DisplayName("Should create audit log for chatbot creation")
    void shouldCreateAuditLogForChatbotCreation() throws Exception {
        // Arrange
        doNothing().when(auditService).logChatbotCreation(eq(1L), eq(100L), anyString());

        // Act & Assert
        mockMvc.perform(post("/api/audit/log/chatbot-create")
                .header("Authorization", authToken)
                .contentType(MediaType.APPLICATION_JSON)
                .content("{\"chatbotId\": 100, \"details\": \"Created new chatbot\"}"))
            .andExpect(status().isOk());

        verify(auditService, times(1)).logChatbotCreation(eq(1L), eq(100L), anyString());
    }

    @Test
    @DisplayName("Should retrieve audit logs for current user")
    void shouldRetrieveAuditLogsForCurrentUser() throws Exception {
        // Arrange
        List<AuditLog> auditLogs = Arrays.asList(testAuditLog);
        when(auditLogRepository.findByUserId(1L)).thenReturn(auditLogs);

        // Act & Assert
        mockMvc.perform(get("/api/audit/logs")
                .header("Authorization", authToken))
            .andExpect(status().isOk())
            .andExpect(jsonPath("$", hasSize(1)))
            .andExpect(jsonPath("$[0].action", equalTo("USER_LOGIN")));

        verify(auditLogRepository, times(1)).findByUserId(1L);
    }

    @Test
    @DisplayName("Should filter audit logs by action type")
    void shouldFilterAuditLogsByActionType() throws Exception {
        // Arrange
        AuditLog loginLog = new AuditLog();
        loginLog.setId(100L);
        loginLog.setUserId(1L);
        loginLog.setAction("USER_LOGIN");
        loginLog.setTimestamp(LocalDateTime.now());

        List<AuditLog> filteredLogs = Arrays.asList(loginLog);
        when(auditLogRepository.findByUserIdAndAction(1L, "USER_LOGIN"))
            .thenReturn(filteredLogs);

        // Act & Assert
        mockMvc.perform(get("/api/audit/logs")
                .header("Authorization", authToken)
                .param("action", "USER_LOGIN"))
            .andExpect(status().isOk())
            .andExpect(jsonPath("$", hasSize(1)))
            .andExpect(jsonPath("$[0].action", equalTo("USER_LOGIN")));

        verify(auditLogRepository, times(1)).findByUserIdAndAction(1L, "USER_LOGIN");
    }

    @Test
    @DisplayName("Should filter audit logs by date range")
    void shouldFilterAuditLogsByDateRange() throws Exception {
        // Arrange
        LocalDateTime startDate = LocalDateTime.now().minusDays(7);
        LocalDateTime endDate = LocalDateTime.now();

        List<AuditLog> filteredLogs = Arrays.asList(testAuditLog);
        when(auditLogRepository.findByUserIdAndTimestampBetween(eq(1L), any(LocalDateTime.class), any(LocalDateTime.class)))
            .thenReturn(filteredLogs);

        // Act & Assert
        mockMvc.perform(get("/api/audit/logs")
                .header("Authorization", authToken)
                .param("startDate", startDate.toString())
                .param("endDate", endDate.toString()))
            .andExpect(status().isOk())
            .andExpect(jsonPath("$", hasSize(greaterThanOrEqualTo(1))));

        verify(auditLogRepository, times(1))
            .findByUserIdAndTimestampBetween(eq(1L), any(LocalDateTime.class), any(LocalDateTime.class));
    }

    @Test
    @DisplayName("Should export audit logs to CSV")
    void shouldExportAuditLogsToCsv() throws Exception {
        // Arrange
        String csvContent = "id,userId,action,timestamp\n100,1,USER_LOGIN,2025-12-18T00:00:00";
        when(auditExportService.exportToCsv(eq(1L))).thenReturn(csvContent);

        // Act & Assert
        mockMvc.perform(get("/api/audit/export/csv")
                .header("Authorization", authToken))
            .andExpect(status().isOk())
            .andExpect(content().contentType(MediaType.parseMediaType("text/csv")))
            .andExpect(content().string(containsString("USER_LOGIN")));

        verify(auditExportService, times(1)).exportToCsv(1L);
    }

    @Test
    @DisplayName("Should export audit logs to JSON")
    void shouldExportAuditLogsToJson() throws Exception {
        // Arrange
        List<AuditLog> auditLogs = Arrays.asList(testAuditLog);
        when(auditLogRepository.findByUserId(1L)).thenReturn(auditLogs);

        // Act & Assert
        mockMvc.perform(get("/api/audit/export/json")
                .header("Authorization", authToken))
            .andExpect(status().isOk())
            .andExpect(content().contentType(MediaType.APPLICATION_JSON))
            .andExpect(jsonPath("$", hasSize(1)));

        verify(auditLogRepository, times(1)).findByUserId(1L);
    }

    @Test
    @DisplayName("Should log security event for failed login")
    void shouldLogSecurityEventForFailedLogin() throws Exception {
        // Arrange
        doNothing().when(auditService).logSecurityEvent(
            eq("FAILED_LOGIN"), anyString(), anyString(), anyString());

        // Act & Assert
        mockMvc.perform(post("/api/audit/security/failed-login")
                .contentType(MediaType.APPLICATION_JSON)
                .content("{\"email\": \"test@example.com\", \"ipAddress\": \"192.168.1.1\", \"userAgent\": \"Mozilla/5.0\"}"))
            .andExpect(status().isOk());

        verify(auditService, times(1)).logSecurityEvent(
            eq("FAILED_LOGIN"), anyString(), anyString(), anyString());
    }

    @Test
    @DisplayName("Should log security event for suspicious activity")
    void shouldLogSecurityEventForSuspiciousActivity() throws Exception {
        // Arrange
        doNothing().when(auditService).logSecurityEvent(
            eq("SUSPICIOUS_ACTIVITY"), anyString(), anyString(), anyString());

        // Act & Assert
        mockMvc.perform(post("/api/audit/security/suspicious")
                .header("Authorization", authToken)
                .contentType(MediaType.APPLICATION_JSON)
                .content("{\"details\": \"Multiple failed login attempts\", \"ipAddress\": \"192.168.1.1\"}"))
            .andExpect(status().isOk());

        verify(auditService, times(1)).logSecurityEvent(
            eq("SUSPICIOUS_ACTIVITY"), anyString(), anyString(), anyString());
    }

    @Test
    @DisplayName("Admin should access all audit logs")
    void adminShouldAccessAllAuditLogs() throws Exception {
        // Arrange
        List<AuditLog> allAuditLogs = Arrays.asList(testAuditLog);
        when(auditLogRepository.findAll()).thenReturn(allAuditLogs);

        // Mock admin check (you may need to adjust based on your security implementation)
        when(userRepository.findById(2L)).thenReturn(Optional.of(adminUser));

        // Act & Assert
        mockMvc.perform(get("/api/audit/admin/all-logs")
                .header("Authorization", adminToken))
            .andExpect(status().isOk())
            .andExpect(jsonPath("$", hasSize(greaterThanOrEqualTo(1))));

        verify(auditLogRepository, times(1)).findAll();
    }

    @Test
    @DisplayName("Should deny access to admin endpoint for non-admin user")
    void shouldDenyAccessToAdminEndpointForNonAdmin() throws Exception {
        // Act & Assert
        mockMvc.perform(get("/api/audit/admin/all-logs")
                .header("Authorization", authToken))
            .andExpect(status().isForbidden());
    }

    @Test
    @DisplayName("Should return 401 when accessing audit logs without authentication")
    void shouldReturn401WithoutAuth() throws Exception {
        // Act & Assert
        mockMvc.perform(get("/api/audit/logs"))
            .andExpect(status().isUnauthorized());
    }

    @Test
    @DisplayName("Should paginate audit logs")
    void shouldPaginateAuditLogs() throws Exception {
        // Arrange
        List<AuditLog> auditLogs = Arrays.asList(testAuditLog);
        when(auditLogRepository.findByUserId(1L)).thenReturn(auditLogs);

        // Act & Assert
        mockMvc.perform(get("/api/audit/logs")
                .header("Authorization", authToken)
                .param("page", "0")
                .param("size", "10"))
            .andExpect(status().isOk())
            .andExpect(jsonPath("$", hasSize(greaterThanOrEqualTo(0))));
    }

    @Test
    @DisplayName("Should get audit log by ID")
    void shouldGetAuditLogById() throws Exception {
        // Arrange
        when(auditLogRepository.findById(100L)).thenReturn(Optional.of(testAuditLog));

        // Act & Assert
        mockMvc.perform(get("/api/audit/logs/{id}", 100L)
                .header("Authorization", authToken))
            .andExpect(status().isOk())
            .andExpect(jsonPath("$.id", equalTo(100)))
            .andExpect(jsonPath("$.action", equalTo("USER_LOGIN")));

        verify(auditLogRepository, times(1)).findById(100L);
    }

    @Test
    @DisplayName("Should return 404 for non-existent audit log")
    void shouldReturn404ForNonExistentAuditLog() throws Exception {
        // Arrange
        when(auditLogRepository.findById(999L)).thenReturn(Optional.empty());

        // Act & Assert
        mockMvc.perform(get("/api/audit/logs/{id}", 999L)
                .header("Authorization", authToken))
            .andExpect(status().isNotFound());

        verify(auditLogRepository, times(1)).findById(999L);
    }

    @Test
    @DisplayName("Should prevent access to other user's audit logs")
    void shouldPreventAccessToOtherUsersAuditLogs() throws Exception {
        // Arrange
        AuditLog otherUserLog = new AuditLog();
        otherUserLog.setId(200L);
        otherUserLog.setUserId(999L); // Different user
        otherUserLog.setAction("USER_LOGIN");

        when(auditLogRepository.findById(200L)).thenReturn(Optional.of(otherUserLog));

        // Act & Assert
        mockMvc.perform(get("/api/audit/logs/{id}", 200L)
                .header("Authorization", authToken))
            .andExpect(status().isForbidden());

        verify(auditLogRepository, times(1)).findById(200L);
    }

    @Test
    @DisplayName("Should log subscription change event")
    void shouldLogSubscriptionChangeEvent() throws Exception {
        // Arrange
        doNothing().when(auditService).logSubscriptionChange(
            eq(1L), eq("FREE"), eq("BASIC"), anyString());

        // Act & Assert
        mockMvc.perform(post("/api/audit/log/subscription-change")
                .header("Authorization", authToken)
                .contentType(MediaType.APPLICATION_JSON)
                .content("{\"oldTier\": \"FREE\", \"newTier\": \"BASIC\", \"details\": \"User upgraded\"}"))
            .andExpect(status().isOk());

        verify(auditService, times(1)).logSubscriptionChange(
            eq(1L), eq("FREE"), eq("BASIC"), anyString());
    }

    @Test
    @DisplayName("Should count audit logs by action type")
    void shouldCountAuditLogsByActionType() throws Exception {
        // Arrange
        when(auditLogRepository.countByUserIdAndAction(1L, "USER_LOGIN")).thenReturn(5L);

        // Act & Assert
        mockMvc.perform(get("/api/audit/logs/count")
                .header("Authorization", authToken)
                .param("action", "USER_LOGIN"))
            .andExpect(status().isOk())
            .andExpect(jsonPath("$.count", equalTo(5)));

        verify(auditLogRepository, times(1)).countByUserIdAndAction(1L, "USER_LOGIN");
    }
}
