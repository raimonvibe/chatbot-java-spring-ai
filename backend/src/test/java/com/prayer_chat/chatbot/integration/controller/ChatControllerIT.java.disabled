package com.prayer_chat.chatbot.integration.controller;

import com.fasterxml.jackson.databind.ObjectMapper;
import com.prayer_chat.chatbot.dto.ChatRequest;
import com.prayer_chat.chatbot.dto.ChatResponse;
import com.prayer_chat.chatbot.helpers.TestDataBuilder;
import com.prayer_chat.chatbot.model.Chatbot;
import com.prayer_chat.chatbot.model.ChatSession;
import com.prayer_chat.chatbot.model.User;
import com.prayer_chat.chatbot.repository.ChatbotRepository;
import com.prayer_chat.chatbot.repository.ChatSessionRepository;
import com.prayer_chat.chatbot.repository.UserRepository;
import com.prayer_chat.chatbot.security.JwtTokenProvider;
import com.prayer_chat.chatbot.service.ChatService;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.DisplayName;
import org.junit.jupiter.api.Test;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.test.autoconfigure.web.servlet.AutoConfigureMockMvc;
import org.springframework.boot.test.context.SpringBootTest;
import org.springframework.http.MediaType;
import org.springframework.test.context.ActiveProfiles;
import org.springframework.test.context.bean.override.mockito.MockitoBean;
import org.springframework.test.web.servlet.MockMvc;

import java.time.LocalDateTime;
import java.util.ArrayList;
import java.util.Optional;
import java.util.UUID;

import static org.hamcrest.Matchers.*;
import static org.mockito.ArgumentMatchers.any;
import static org.mockito.ArgumentMatchers.*;
import static org.mockito.Mockito.*;
import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.*;
import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.*;

/**
 * Integration tests for ChatController
 *
 * Tests covered:
 * - Chat message processing with AI service (mocked)
 * - Session management
 * - Multi-turn conversations
 * - Language switching mid-conversation
 * - Rate limiting enforcement
 * - Public chatbot access
 */
@SpringBootTest
@AutoConfigureMockMvc
@ActiveProfiles("test")
@DisplayName("ChatController Integration Tests")
class ChatControllerIT {

    @Autowired
    private MockMvc mockMvc;

    @Autowired
    private ObjectMapper objectMapper;

    @MockitoBean
    private ChatService chatService;

    @MockitoBean
    private ChatbotRepository chatbotRepository;

    @MockitoBean
    private ChatSessionRepository chatSessionRepository;

    @MockitoBean
    private UserRepository userRepository;

    @MockitoBean
    private JwtTokenProvider jwtTokenProvider;

    private User testUser;
    private Chatbot testChatbot;
    private ChatSession testSession;
    private String authToken;

    @BeforeEach
    void setUp() {
        testUser = TestDataBuilder.createTestUser("chat@example.com");
        testUser.setId(1L);

        testChatbot = TestDataBuilder.createTestChatbot(testUser);
        testChatbot.setId(100L);
        testChatbot.setPublicAccess(false);

        testSession = new ChatSession();
        testSession.setId(UUID.randomUUID().toString());
        testSession.setChatbot(testChatbot);
        testSession.setMessages(new ArrayList<>());
        testSession.setLanguage("en");
        testSession.setCreatedAt(LocalDateTime.now());

        authToken = "Bearer test_token_123";

        // Mock JWT token validation
        when(jwtTokenProvider.validateToken(anyString())).thenReturn(true);
        when(jwtTokenProvider.getUserIdFromToken(anyString())).thenReturn(1L);
        when(userRepository.findById(1L)).thenReturn(Optional.of(testUser));
    }

    @Test
    @DisplayName("Should process chat message successfully")
    void shouldProcessChatMessageSuccessfully() throws Exception {
        // Arrange
        ChatRequest request = new ChatRequest();
        request.setMessage("Hello, how can you help me?");
        request.setSessionId(testSession.getId());
        request.setLanguage("en");

        ChatResponse mockResponse = new ChatResponse();
        mockResponse.setMessage("I can help you with various tasks! What do you need assistance with?");
        mockResponse.setSessionId(testSession.getId());

        when(chatbotRepository.findById(100L)).thenReturn(Optional.of(testChatbot));
        when(chatService.processMessage(any(ChatRequest.class), eq(testChatbot)))
            .thenReturn(mockResponse);

        // Act & Assert
        mockMvc.perform(post("/api/chat/{chatbotId}", 100L)
                .header("Authorization", authToken)
                .contentType(MediaType.APPLICATION_JSON)
                .content(objectMapper.writeValueAsString(request)))
            .andExpect(status().isOk())
            .andExpect(jsonPath("$.message", notNullValue()))
            .andExpect(jsonPath("$.sessionId", equalTo(testSession.getId())));

        // Verify service was called
        verify(chatService, times(1)).processMessage(any(ChatRequest.class), eq(testChatbot));
    }

    @Test
    @DisplayName("Should create new chat session if session ID not provided")
    void shouldCreateNewChatSession() throws Exception {
        // Arrange
        ChatRequest request = new ChatRequest();
        request.setMessage("Hello");
        request.setSessionId(null); // No session ID

        String newSessionId = UUID.randomUUID().toString();
        ChatResponse mockResponse = new ChatResponse();
        mockResponse.setMessage("Hello! I'm here to help.");
        mockResponse.setSessionId(newSessionId);

        when(chatbotRepository.findById(100L)).thenReturn(Optional.of(testChatbot));
        when(chatService.processMessage(any(ChatRequest.class), eq(testChatbot)))
            .thenReturn(mockResponse);

        // Act & Assert
        mockMvc.perform(post("/api/chat/{chatbotId}", 100L)
                .header("Authorization", authToken)
                .contentType(MediaType.APPLICATION_JSON)
                .content(objectMapper.writeValueAsString(request)))
            .andExpect(status().isOk())
            .andExpect(jsonPath("$.sessionId", notNullValue()));
    }

    @Test
    @DisplayName("Should handle multi-turn conversation")
    void shouldHandleMultiTurnConversation() throws Exception {
        // Arrange
        String sessionId = testSession.getId();

        ChatRequest request1 = new ChatRequest();
        request1.setMessage("What's your name?");
        request1.setSessionId(sessionId);

        ChatResponse response1 = new ChatResponse();
        response1.setMessage("I'm Prayer-Chat, your AI assistant!");
        response1.setSessionId(sessionId);

        ChatRequest request2 = new ChatRequest();
        request2.setMessage("What can you do?");
        request2.setSessionId(sessionId);

        ChatResponse response2 = new ChatResponse();
        response2.setMessage("I can answer questions about your website!");
        response2.setSessionId(sessionId);

        when(chatbotRepository.findById(100L)).thenReturn(Optional.of(testChatbot));
        when(chatService.processMessage(any(ChatRequest.class), eq(testChatbot)))
            .thenReturn(response1, response2);

        // Act & Assert: First message
        mockMvc.perform(post("/api/chat/{chatbotId}", 100L)
                .header("Authorization", authToken)
                .contentType(MediaType.APPLICATION_JSON)
                .content(objectMapper.writeValueAsString(request1)))
            .andExpect(status().isOk())
            .andExpect(jsonPath("$.sessionId", equalTo(sessionId)));

        // Act & Assert: Second message in same session
        mockMvc.perform(post("/api/chat/{chatbotId}", 100L)
                .header("Authorization", authToken)
                .contentType(MediaType.APPLICATION_JSON)
                .content(objectMapper.writeValueAsString(request2)))
            .andExpect(status().isOk())
            .andExpect(jsonPath("$.sessionId", equalTo(sessionId)));

        // Verify service was called twice
        verify(chatService, times(2)).processMessage(any(ChatRequest.class), eq(testChatbot));
    }

    @Test
    @DisplayName("Should handle language switching mid-conversation")
    void shouldHandleLanguageSwitching() throws Exception {
        // Arrange
        String sessionId = testSession.getId();

        ChatRequest requestEn = new ChatRequest();
        requestEn.setMessage("Hello");
        requestEn.setSessionId(sessionId);
        requestEn.setLanguage("en");

        ChatRequest requestEs = new ChatRequest();
        requestEs.setMessage("Hola");
        requestEs.setSessionId(sessionId);
        requestEs.setLanguage("es");

        ChatResponse responseEn = new ChatResponse();
        responseEn.setMessage("Hello! How can I help you?");
        responseEn.setSessionId(sessionId);

        ChatResponse responseEs = new ChatResponse();
        responseEs.setMessage("¡Hola! ¿Cómo puedo ayudarte?");
        responseEs.setSessionId(sessionId);

        when(chatbotRepository.findById(100L)).thenReturn(Optional.of(testChatbot));
        when(chatService.processMessage(any(ChatRequest.class), eq(testChatbot)))
            .thenReturn(responseEn, responseEs);

        // Act & Assert: English message
        mockMvc.perform(post("/api/chat/{chatbotId}", 100L)
                .header("Authorization", authToken)
                .contentType(MediaType.APPLICATION_JSON)
                .content(objectMapper.writeValueAsString(requestEn)))
            .andExpect(status().isOk());

        // Act & Assert: Spanish message
        mockMvc.perform(post("/api/chat/{chatbotId}", 100L)
                .header("Authorization", authToken)
                .contentType(MediaType.APPLICATION_JSON)
                .content(objectMapper.writeValueAsString(requestEs)))
            .andExpect(status().isOk());

        verify(chatService, times(2)).processMessage(any(ChatRequest.class), eq(testChatbot));
    }

    @Test
    @DisplayName("Should allow public access to public chatbot without authentication")
    void shouldAllowPublicAccessToPublicChatbot() throws Exception {
        // Arrange
        testChatbot.setPublicAccess(true); // Make chatbot public

        ChatRequest request = new ChatRequest();
        request.setMessage("Hello");

        ChatResponse mockResponse = new ChatResponse();
        mockResponse.setMessage("Hello! Welcome!");
        mockResponse.setSessionId(UUID.randomUUID().toString());

        when(chatbotRepository.findById(100L)).thenReturn(Optional.of(testChatbot));
        when(chatService.processMessage(any(ChatRequest.class), eq(testChatbot)))
            .thenReturn(mockResponse);

        // Act & Assert: No Authorization header
        mockMvc.perform(post("/api/chat/{chatbotId}", 100L)
                .contentType(MediaType.APPLICATION_JSON)
                .content(objectMapper.writeValueAsString(request)))
            .andExpect(status().isOk())
            .andExpect(jsonPath("$.message", notNullValue()));
    }

    @Test
    @DisplayName("Should deny access to private chatbot without authentication")
    void shouldDenyAccessToPrivateChatbotWithoutAuth() throws Exception {
        // Arrange
        testChatbot.setPublicAccess(false); // Ensure private

        ChatRequest request = new ChatRequest();
        request.setMessage("Hello");

        when(chatbotRepository.findById(100L)).thenReturn(Optional.of(testChatbot));

        // Act & Assert: No Authorization header for private chatbot
        mockMvc.perform(post("/api/chat/{chatbotId}", 100L)
                .contentType(MediaType.APPLICATION_JSON)
                .content(objectMapper.writeValueAsString(request)))
            .andExpect(status().isUnauthorized());
    }

    @Test
    @DisplayName("Should return 404 when chatbot not found")
    void shouldReturn404WhenChatbotNotFound() throws Exception {
        // Arrange
        ChatRequest request = new ChatRequest();
        request.setMessage("Hello");

        when(chatbotRepository.findById(999L)).thenReturn(Optional.empty());

        // Act & Assert
        mockMvc.perform(post("/api/chat/{chatbotId}", 999L)
                .header("Authorization", authToken)
                .contentType(MediaType.APPLICATION_JSON)
                .content(objectMapper.writeValueAsString(request)))
            .andExpect(status().isNotFound());
    }

    @Test
    @DisplayName("Should return 400 for empty message")
    void shouldReturn400ForEmptyMessage() throws Exception {
        // Arrange
        ChatRequest request = new ChatRequest();
        request.setMessage(""); // Empty message

        when(chatbotRepository.findById(100L)).thenReturn(Optional.of(testChatbot));

        // Act & Assert
        mockMvc.perform(post("/api/chat/{chatbotId}", 100L)
                .header("Authorization", authToken)
                .contentType(MediaType.APPLICATION_JSON)
                .content(objectMapper.writeValueAsString(request)))
            .andExpect(status().isBadRequest());
    }

    @Test
    @DisplayName("Should retrieve conversation history")
    void shouldRetrieveConversationHistory() throws Exception {
        // Arrange
        String sessionId = testSession.getId();

        when(chatSessionRepository.findById(sessionId)).thenReturn(Optional.of(testSession));
        when(chatbotRepository.findById(100L)).thenReturn(Optional.of(testChatbot));

        // Act & Assert
        mockMvc.perform(get("/api/chat/{chatbotId}/history/{sessionId}", 100L, sessionId)
                .header("Authorization", authToken))
            .andExpect(status().isOk())
            .andExpect(jsonPath("$", notNullValue()));
    }

    @Test
    @DisplayName("Should return 404 for non-existent session")
    void shouldReturn404ForNonExistentSession() throws Exception {
        // Arrange
        String fakeSessionId = UUID.randomUUID().toString();

        when(chatSessionRepository.findById(fakeSessionId)).thenReturn(Optional.empty());
        when(chatbotRepository.findById(100L)).thenReturn(Optional.of(testChatbot));

        // Act & Assert
        mockMvc.perform(get("/api/chat/{chatbotId}/history/{sessionId}", 100L, fakeSessionId)
                .header("Authorization", authToken))
            .andExpect(status().isNotFound());
    }

    @Test
    @DisplayName("Should handle AI service timeout gracefully")
    void shouldHandleAiServiceTimeout() throws Exception {
        // Arrange
        ChatRequest request = new ChatRequest();
        request.setMessage("Hello");

        when(chatbotRepository.findById(100L)).thenReturn(Optional.of(testChatbot));
        when(chatService.processMessage(any(ChatRequest.class), eq(testChatbot)))
            .thenThrow(new RuntimeException("AI service timeout"));

        // Act & Assert
        mockMvc.perform(post("/api/chat/{chatbotId}", 100L)
                .header("Authorization", authToken)
                .contentType(MediaType.APPLICATION_JSON)
                .content(objectMapper.writeValueAsString(request)))
            .andExpect(status().is5xxServerError());
    }

    @Test
    @DisplayName("Should enforce rate limiting on chat messages")
    void shouldEnforceRateLimiting() throws Exception {
        // Arrange
        ChatRequest request = new ChatRequest();
        request.setMessage("Test");

        ChatResponse mockResponse = new ChatResponse();
        mockResponse.setMessage("Response");
        mockResponse.setSessionId(testSession.getId());

        when(chatbotRepository.findById(100L)).thenReturn(Optional.of(testChatbot));
        when(chatService.processMessage(any(ChatRequest.class), eq(testChatbot)))
            .thenReturn(mockResponse);

        // Act: Send multiple rapid requests
        for (int i = 0; i < 10; i++) {
            mockMvc.perform(post("/api/chat/{chatbotId}", 100L)
                    .header("Authorization", authToken)
                    .contentType(MediaType.APPLICATION_JSON)
                    .content(objectMapper.writeValueAsString(request)));
        }

        // Note: Actual rate limiting would require specific implementation
        // This test validates that multiple requests are processed
        verify(chatService, atLeast(1)).processMessage(any(ChatRequest.class), eq(testChatbot));
    }

    @Test
    @DisplayName("Should handle special characters in messages")
    void shouldHandleSpecialCharactersInMessages() throws Exception {
        // Arrange
        ChatRequest request = new ChatRequest();
        request.setMessage("Hello! <script>alert('xss')</script>");

        ChatResponse mockResponse = new ChatResponse();
        mockResponse.setMessage("Hello! How can I help?");
        mockResponse.setSessionId(testSession.getId());

        when(chatbotRepository.findById(100L)).thenReturn(Optional.of(testChatbot));
        when(chatService.processMessage(any(ChatRequest.class), eq(testChatbot)))
            .thenReturn(mockResponse);

        // Act & Assert
        mockMvc.perform(post("/api/chat/{chatbotId}", 100L)
                .header("Authorization", authToken)
                .contentType(MediaType.APPLICATION_JSON)
                .content(objectMapper.writeValueAsString(request)))
            .andExpect(status().isOk());

        verify(chatService, times(1)).processMessage(any(ChatRequest.class), eq(testChatbot));
    }

    @Test
    @DisplayName("Should handle very long messages")
    void shouldHandleVeryLongMessages() throws Exception {
        // Arrange
        String longMessage = "A".repeat(5000); // 5KB message
        ChatRequest request = new ChatRequest();
        request.setMessage(longMessage);

        ChatResponse mockResponse = new ChatResponse();
        mockResponse.setMessage("Response to long message");
        mockResponse.setSessionId(testSession.getId());

        when(chatbotRepository.findById(100L)).thenReturn(Optional.of(testChatbot));
        when(chatService.processMessage(any(ChatRequest.class), eq(testChatbot)))
            .thenReturn(mockResponse);

        // Act & Assert
        mockMvc.perform(post("/api/chat/{chatbotId}", 100L)
                .header("Authorization", authToken)
                .contentType(MediaType.APPLICATION_JSON)
                .content(objectMapper.writeValueAsString(request)))
            .andExpect(status().isOk());
    }
}
