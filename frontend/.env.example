# API Configuration
# For local development (backend on 8081)
NEXT_PUBLIC_API_URL=http://localhost:8081

# Billing / Stripe UI (must match backend APP_BILLING_ENABLED). When false, checkout and portal are hidden.
NEXT_PUBLIC_BILLING_ENABLED=false

# For production (Vercel + custom domain + vercel.json /api rewrite to Java):
# NEXT_PUBLIC_API_URL=https://prayer-chat.com
# (Must match the site origin so PC_AUTH is first-party; do not use the raw Render URL here.)
#
# Legacy: direct cross-origin API (breaks cookie auth on mobile Safari):
# NEXT_PUBLIC_API_URL=https://your-backend.onrender.com

# Google OAuth - required for "Sign in with Google" (same as backend GOOGLE_CLIENT_ID)
# Get from Google Cloud Console: APIs & Services > Credentials > your Web client
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Optional: Default Chatbot ID
NEXT_PUBLIC_DEFAULT_CHATBOT_ID=1
