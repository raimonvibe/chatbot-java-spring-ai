{
  "name": "prayer-chat-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest --watch",
    "test:ci": "jest --ci --coverage --maxWorkers=2 --forceExit",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:pages": "playwright test e2e/pages",
    "test:e2e:flows": "playwright test e2e/flows",
    "test:e2e:components": "playwright test e2e/components",
    "test:e2e:mobile": "playwright test e2e/mobile-responsiveness.spec.ts",
    "test:e2e:critical": "playwright test e2e/pages/home.spec.ts e2e/pages/login.spec.ts e2e/pages/dashboard.spec.ts",
    "test:e2e:auth": "playwright test e2e/pages/login.spec.ts e2e/flows/new-user-flow.spec.ts",
    "test:e2e:chatbot": "playwright test e2e/pages/chatbot-detail.spec.ts e2e/pages/chatbot-preview.spec.ts e2e/flows/create-chatbot-flow.spec.ts",
    "test:e2e:subscription": "playwright test e2e/pages/pricing.spec.ts e2e/flows/subscription-upgrade-flow.spec.ts",
    "test:e2e:ui": "playwright test e2e/components e2e/mobile-responsiveness.spec.ts",
    "test:e2e:smoke": "playwright test e2e/pages/home.spec.ts e2e/pages/login.spec.ts --grep @smoke",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@visx/pattern": "^3.12.0",
    "clsx": "^2.1.0",
    "framer-motion": "^12.34.3",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.576.0",
    "next": "^16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-spinners": "^0.17.0"
  },
  "overrides":{"minimatch":"3.1.5"},"devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.22",
    "eslint": "^10.0.1",
    "eslint-config-next": "^16.1.6",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.3.0"
  }
