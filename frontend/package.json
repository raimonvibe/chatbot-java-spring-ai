{
  "name": "prayer-chat-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest --watch",
    "test:ci": "jest --ci --coverage --maxWorkers=2 --forceExit",
    "test:ci:serial": "jest --ci --coverage --runInBand --forceExit",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:pages": "playwright test e2e/pages",
    "test:e2e:flows": "playwright test e2e/flows",
    "test:e2e:components": "playwright test e2e/components",
    "test:e2e:mobile": "playwright test e2e/mobile-responsiveness.spec.ts",
    "test:e2e:critical": "playwright test e2e/pages/home.spec.ts e2e/pages/login.spec.ts e2e/pages/dashboard.spec.ts",
    "test:e2e:auth": "playwright test e2e/pages/login.spec.ts e2e/flows/new-user-flow.spec.ts",
    "test:e2e:chatbot": "playwright test e2e/pages/chatbot-detail.spec.ts e2e/pages/chatbot-preview.spec.ts e2e/flows/create-chatbot-flow.spec.ts",
    "test:e2e:subscription": "playwright test e2e/pages/pricing.spec.ts e2e/flows/subscription-upgrade-flow.spec.ts",
    "test:e2e:ui": "playwright test e2e/components e2e/mobile-responsiveness.spec.ts",
    "test:e2e:smoke": "playwright test e2e/pages/home.spec.ts e2e/pages/login.spec.ts --grep @smoke",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "^4.3.3",
    "@visx/pattern": "^4.0.0",
    "clsx": "^2.1.0",
    "framer-motion": "^13.0.0",
    "lottie-react": "^2.4.1",
    "lucide-react": "^1.31.0",
    "next": "^16.3.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.8",
    "react-spinners": "^0.17.0"
  },
  "overrides": {
    "minimatch": "3.1.5",
    "postcss": "$postcss",
    "js-yaml": "^4.3.1",
    "nanoid": "^3.3.17",
    "@babel/core": "^7.29.6",
    "ws": "^8.20.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.5.2",
    "eslint": "^10.8.0",
    "eslint-config-next": "^16.3.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.3.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.2",
    "typescript": "^7.0.2"
  }
}
