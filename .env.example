# ===========================================
# CHATWEAVE AI CHATBOT - ENVIRONMENT VARIABLES
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control!
# ===========================================

# -----------------------------
# AI API KEYS (REQUIRED)
# -----------------------------
# Get your Anthropic API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Get your Cohere API key from: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=your-cohere-api-key-here

# -----------------------------
# JWT SECURITY (REQUIRED)
# -----------------------------
# Generate a secure random string (minimum 32 characters)
# You can generate one with: openssl rand -base64 32
JWT_SECRET=your-secret-key-at-least-32-characters-long
JWT_EXPIRATION=86400000

# -----------------------------
# CORS CONFIGURATION (REQUIRED)
# -----------------------------
# Comma-separated list of allowed origins
# Development: http://localhost:3000
# Production: https://yourdomain.com,https://www.yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:3000

# -----------------------------
# DATABASE CONFIGURATION
# -----------------------------
# For development (H2)
SPRING_DATASOURCE_URL=jdbc:h2:mem:chatbotdb
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.h2.Driver
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=
H2_CONSOLE_ENABLED=false
DDL_AUTO=update
SHOW_SQL=false

# For production (PostgreSQL)
# Uncomment and configure when deploying:
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/chatbot
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=your-secure-password
# SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver

# -----------------------------
# LOGGING
# -----------------------------
LOG_LEVEL=INFO

# -----------------------------
# SERVER CONFIGURATION
# -----------------------------
PORT=8080

# -----------------------------
# OAUTH (OPTIONAL)
# -----------------------------
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# -----------------------------
# STRIPE PAYMENT (OPTIONAL)
# -----------------------------
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
STRIPE_PRICE_ID=your-stripe-price-id
STRIPE_SUCCESS_URL=http://localhost:3000/dashboard?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:3000/pricing
