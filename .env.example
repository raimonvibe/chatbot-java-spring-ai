# =============================================================================
# Prayer-Chat AI Chatbot - Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your actual API keys
# 
# For local development:
#   cp .env.example .env
#   # Then edit .env with your actual keys
#
# For production (Render):
#   Set these as environment variables in the Render dashboard
#   Do NOT commit .env to git (it's in .gitignore)

# =============================================================================
# AI API Keys (REQUIRED for chat functionality)
# =============================================================================
# Get your Anthropic API key from: https://console.anthropic.com/
# This is used for Claude AI chat responses
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Get your Cohere API key from: https://dashboard.cohere.com/
# This is used for text embeddings (vector search)
COHERE_API_KEY=your-cohere-api-key-here

# =============================================================================
# OAuth2 Configuration (REQUIRED for user authentication)
# =============================================================================
# Get these from Google Cloud Console: https://console.cloud.google.com/
# See OAUTH_STRIPE_SETUP.md for detailed setup instructions
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# =============================================================================
# Security (REQUIRED)
# =============================================================================
# Generate a secure random string for JWT token signing
# You can generate one with: openssl rand -base64 32
# Or use: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=your-secure-random-jwt-secret-here

# =============================================================================
# Optional: Pinecone Vector Store (for production)
# =============================================================================
# Only needed if you want to use Pinecone instead of in-memory vector store
# Get your keys from: https://app.pinecone.io/
# PINECONE_API_KEY=your-pinecone-api-key
# PINECONE_ENVIRONMENT=your-pinecone-environment
# PINECONE_INDEX_NAME=chatbot-vectors

# =============================================================================
# Billing toggle (free product vs paid)
# =============================================================================
# When false (default for free launch), Stripe checkout/portal/webhook processing are disabled; quotas stay generous.
# Frontend should set NEXT_PUBLIC_BILLING_ENABLED to the same value. See docs/FREE_PRODUCT_BILLING.md
APP_BILLING_ENABLED=false

# =============================================================================
# Optional: Stripe Payment Integration
# =============================================================================
# Required when APP_BILLING_ENABLED=true
# Get your keys from: https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
# STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# =============================================================================
# Database Configuration (Optional - defaults to H2 for local development)
# =============================================================================
# For local PostgreSQL:
# DATABASE_URL=jdbc:postgresql://localhost:5432/chatbot
# DATABASE_USERNAME=postgres
# DATABASE_PASSWORD=postgres
# DATABASE_DRIVER=org.postgresql.Driver
# HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# =============================================================================
# Server Configuration (Optional)
# =============================================================================
# PORT=8081
# CORS_ALLOWED_ORIGINS=http://localhost:3000,https://prayer-chat.com
